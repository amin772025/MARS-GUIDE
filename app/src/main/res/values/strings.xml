    <string name="about_title">NASA Data Sources &amp; Attribution</string>
    <string name="about_attribution_title">Official Attribution</string>
    <string name="about_attribution_text">Data used by MARS//GUIDE originates from publicly accessible NASA planetary science archives, including the NASA Planetary Data System (PDS), USGS Astrogeology Science Center, and NASA/JPL Mars Mission archives. This application is an independent submission for the 2026 NASA Space Apps Challenge and is not an official NASA application, nor is it endorsed or certified by NASA.</string>
    <string name="about_datasets_title">Primary Integrated Datasets</string>
    <string name="about_pds_title">NASA Planetary Data System (PDS)</string>
    <string name="about_pds_desc">PDS Geosciences and Imaging Nodes provide archived science packets, MOLA topographic data, and calibrated mission products.</string>
    <string name="about_usgs_title">USGS Astrogeology Mars Gazetteer</string>
    <string name="about_usgs_desc">Official International Astronomical Union (IAU) planetary nomenclature and verified center coordinates.</string>
    <string name="about_jpl_title">NASA/JPL Mars Exploration Program</string>
    <string name="about_jpl_desc">Telemetry, landing site coordinates, and instrument catalogs for Curiosity, Perseverance, Spirit, Opportunity, and MRO.</string>
    <string name="about_hirise_title">MRO HiRISE &amp; CTX Data</string>
    <string name="about_hirise_desc">High-resolution Martian surface imagery and Digital Terrain Models (DTMs).</string>

